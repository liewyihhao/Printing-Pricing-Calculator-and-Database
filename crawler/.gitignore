.env
.venv/
__pycache__/
*.pyc
state/
output/*
# authored, versioned spec content (our own factual per-product depth) — keep tracked
!output/spec_content/
# crawled production facts (min/max limits, thickness) folded into product pages — keep tracked
!output/spec_facts/
# supplier site intelligence + option-parity gap backlog — keep tracked (small, reviewable)
!output/excard_intelligence.json
!output/option_gap_audit.json
!output/parity_full_audit.json
!output/option_images_full.json
!output/option_images_scan.json
# JS-rendered loose-sheet folding-code diagrams (captured PNGs) + their field mapping — keep
# tracked so a fresh rebuild can re-embed them (they feed img_cache + build_standalone)
!output/fold_images.json
!output/fold_diagrams/
!output/fold_diagrams/**
