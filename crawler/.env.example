# Copy this file to ".env" and fill in your real Excard reseller credentials.
# The .env file is git-ignored and never sent anywhere except to excard.com.my at login.
EXCARD_USERNAME=yushancorporation
EXCARD_PASSWORD=

# Target page for the Phase 1 proof-of-crawl
EXCARD_PRICE_URL=https://www.excard.com.my/price-list/Litho/21
EXCARD_LOGIN_URL=https://www.excard.com.my/login

# Politeness: milliseconds to wait between actions (be gentle to their server)
CRAWL_MIN_DELAY_MS=1500
CRAWL_MAX_DELAY_MS=3500

# Set to "false" to watch the browser visually (recommended for first run),
# "true" to run without a visible window.
HEADLESS=false

# --- PostgreSQL (local PG 18 instance) ---
# Fill PGPASSWORD with your postgres superuser password (set during install).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=printoka

# Crawl runner tuning
CRAWL_MAX_ATTEMPTS=3
CRAWL_WORKERS=1
GENERATE_TIMEOUT_MS=50000
